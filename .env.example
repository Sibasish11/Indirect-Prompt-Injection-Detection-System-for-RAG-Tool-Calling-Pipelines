# Copy this file to .env and fill in your key. Never commit .env itself.
# Get an OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

# Optional: choose another OpenRouter chat model, including a model ending
# in :free when available.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
